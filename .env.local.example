# Copy to .env.local for `docker run --env-file .env.local` against the compose Postgres.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5434
POSTGRES_DB=changectl
POSTGRES_USER=changectl
POSTGRES_PASSWORD=changectl
CHANGECTL_LOCAL_STORAGE=/tmp/changectl-storage
CHANGECTL_DEV_USER_EMAIL=dev@example.test
GOOGLE_OAUTH_CLIENT_ID=unused-locally
